    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.1",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.10.1",
