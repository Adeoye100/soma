{
  "name": "smart-examination-backend",
  "version": "1.0.0",
  "description": "Secure, production-ready backend service for soma",
  "main": "dist/index.js",
  "author": "Adeoye Opeyemi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/smart-examination-backend"
  },
  "bugs": {
    "url": "https://github.com/your-org/smart-examination-backend/issues"
  },
  "homepage": "https://github.com/your-org/smart-examination-backend#readme",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t smart-exam-backend .",
    "docker:run": "docker run -p 3000:3000 smart-exam-backend",
    "precommit": "pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
