      "uuid": ">=11.1.1",
      "protobufjs": ">=7.5.5",
      "axios": ">=1.15.2",
      "follow-redirects": ">=1.16.0",
      "minimatch": ">=9.0.7",
      "qs": ">=6.14.2",
      "multer": "1.4.5-lts.1",
      "nodemailer@<7.0.7": ">=7.0.7",
      "nodemailer@<=7.0.10": ">=7.0.11",
      "nodemailer@<8.0.4": ">=8.0.4",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "nodemailer@<=8.0.4": ">=8.0.5",
      "@opentelemetry/auto-instrumentations-node@<0.75.0": ">=0.75.0",
