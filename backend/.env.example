# File Processing Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
TEMP_PATH=./temp
QUARANTINE_PATH=./quarantine

# Malware Scanning (optional - leave empty for local ClamAV)
MALWARE_SCANNING_ENABLED=true
MALWARE_SCAN_ENDPOINT=

# OCR Configuration
OCR_LANGUAGE=eng
OCR_ENHANCEMENT=true

# Processing Limits
MAX_PARSING_TIME=120000
CLEANUP_TEMP_FILES=true

# Admin Configuration
ADMIN_EMAILS=admin@soma.app

# Redis (set REDIS_ENABLED=false to silence errors when Redis is not running)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
